# Template for local configuration. Copy to `.env` (git-ignored) and fill in as needed.
# Stage 0 needs nothing set: every value below is optional and has a working default.

# --- API metadata (optional) ---------------------------------------------------------
# SERVICE_NAME=jobpulse-backend
# ENVIRONMENT=development

# --- Stage 8: browsers allowed to call this API (optional) ---------------------------
# Must be a JSON list, because `Settings.cors_origins` is typed as list[str].
# CORS_ORIGINS=["http://localhost:3000"]

# --- Stage 6: Google Gemini (free tier) ----------------------------------------------
# GEMINI_API_KEY=

# --- Stage 4: retrieval ---------------------------------------------------------------
# The same embedding model must be used for indexing and for querying.
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# CHROMA_PERSIST_DIR=../data/chroma
